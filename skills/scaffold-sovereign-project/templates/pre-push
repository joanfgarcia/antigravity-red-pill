#!/bin/sh
# Sovereign Git guard: block direct pushes to main and force pushes.

z40=0000000000000000000000000000000000000000

while read local_ref local_sha remote_ref remote_sha
do
	if [ "$remote_ref" = "refs/heads/main" ]
	then
		echo "============================================================"
		echo "🔴 SOVEREIGNTY GUARD: DIRECT PUSH TO 'main' BLOCKED"
		echo "main only moves through a Pull Request (docs/CORE/WORKFLOWS.md §0)."
		echo "Push your work branch or 'next' instead."
		echo "============================================================"
		exit 1
	fi

	if [ "$local_sha" = "$z40" ]
	then
		continue
	fi

	if [ "$remote_sha" = "$z40" ]
	then
		continue
	fi

	if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"
	then
		echo "============================================================"
		echo "🔴 SOVEREIGNTY GUARD: FORCE PUSH DETECTED AND BLOCKED"
		echo "Pushing this branch would overwrite remote history."
		echo "Merge or revert instead; never rewrite shared history."
		echo "============================================================"
		exit 1
	fi
done

exit 0
