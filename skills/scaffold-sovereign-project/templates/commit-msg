#!/usr/bin/env bash
# git commit-msg hook to enforce conventional commits

commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# Regex for conventional commits
regex="^(feat|fix|docs|test|chore|cert|refactor|perf)(\([a-z0-9_-]+\))?: [a-z0-9A-Z_ -]+"

if [[ ! $commit_msg =~ $regex ]]; then
    echo "============================================================"
    echo "🔴 SOVEREIGNTY GUARD: INVALID COMMIT MESSAGE"
    echo "Commit messages must follow the Conventional Commits format:"
    echo "<type>(<scope>): <subject>"
    echo "Allowed types: feat, fix, docs, test, chore, cert, refactor, perf"
    echo "Example: feat: add sovereign P2P router"
    echo "============================================================"
    exit 1
fi
exit 0
