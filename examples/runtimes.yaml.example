# runtimes.yaml — registro de engines de inferencia local (RFC-HARNESS-003).
#
# Los perfiles de modelo (`model_profiles.yaml`) se anclan a un engine con
# `runtime: <id>`; sin campo, aplica `default_runtime`. `binary`/`server`
# aceptan ruta relativa (al bunker root, p.ej. el repo) o ~/absoluta.
# Un runtime declarado y no disponible es un FALLO LIMPIO — nunca fallback
# silencioso a otro engine (`Q2_0` ternario en stock produce basura sin warning).
#
# ⚠️ AVISO DE CALIBRACIÓN: este fichero es un EJEMPLO. Las rutas, versiones,
# flags de build y notas de `quirks` son del PUESTO DE REFERENCIA (RTX 5070
# Laptop 8 GB, 2026-10-08). Cada equipo debe compilar/instalar sus engines y
# ajustar aquí sus rutas y versiones reales; las medidas de contexto de `quirks`
# se recalibran por equipo (no se copian).
#
# Este fichero se siembra copy-if-absent desde examples/ en install/update
# (mismo patrón que task_profiles.yaml). La config viva del puesto vive en
# ~/.config/red-pill/runtimes.yaml — nunca se comitea.
default_runtime: llama_cpp_stock

runtimes:
  # Pipeline clásico: binario oficial + llama-cpp-python del daemon.
  llama_cpp_stock:
    kind: llama_cpp
    description: "llama.cpp oficial (stock) — quant types estándar (K-quants, Q8, F16)"
    binary: "3rdparty/llama_official/build/bin/llama-cli"
    server: "3rdparty/llama_official/build/bin/llama-server"
    capabilities:
      quant_types: ["f16", "q8_0", "q4_k_m", "k_quants", "legacy_quants"]
    status: active

  # Fork PrismML: kernels ternarios (PTQ1_0/PQ2_0) + transform de Hadamard.
  # REQUIERE build propio (stock rechaza PTQ1_0/PQ2_0; Q2_0 en stock = basura).
  llama_cpp_prism:
    kind: llama_cpp_fork
    description: "Fork PrismML — ternarios Bonsai 2 (PTQ1_0 1.75 bpw / PQ2_0 2.13 bpw)"
    binary: "~/opt/llama.cpp-prism/build/bin/llama-cli"
    server: "~/opt/llama.cpp-prism/build/bin/llama-server"
    version: "b1-4fbda12 (rama prism)"
    build:
      cuda_arch: "120a-real"
      flags: ["GGML_CUDA=ON", "GGML_CUDA_FA_ALL_QUANTS=ON"]
    capabilities:
      quant_types: ["f16", "q8_0", "q4_k_m", "k_quants", "PTQ1_0", "PQ2_0"]
      reasoning_kwargs: true
    quirks:
      notes: "PUESTO DE REFERENCIA (recalibrar): 8 GB VRAM → -np 1; ctx verificado f16 24K / q8_0 32K / q4_0 64K (2026-10-08)"
    status: active

  # FastFlowLM (FLM) — runtime NPU-first oficial AMD (XDNA2: Strix/Halo/Kraken).
  # Sirve por `flm serve <model_tag>` (OpenAI-compatible en :52625); el modelo
  # carga lazy en el primer request. UN modelo a la vez: las peticiones se
  # encolan y cambiar de modelo = recarga (13-79 s según tamaño). Runtime MIT
  # (org ROCm); kernels/modelos curados q4nx (catálogo cerrado, ver docs FLM).
  fastflowlm:
    kind: fastflowlm
    description: "FastFlowLM — NPU Ryzen AI (XDNA2), kernels fusionados por modelo"
    binary: "flm"
    server: "flm serve"
    capabilities:
      backends: ["npu"]
      quant_types: ["q4nx (propietario)"]
      vision: true
      audio: true
    quirks:
      notes: "PUESTO DE REFERENCIA (recalibrar): gpt-oss:20b 19.5 t/s · 35B-A3B 14.5-17.6 · 9B 5.6 · 27B 1.6/2.8 (MTP) · gemma4-12b 5-6.5 (2026-10-09). Server default ctx ~8K → perfiles que necesiten más: serve_args: ['--ctx-len','16384']. Modelos en ~/.config/flm/models (pull una vez; pulls largos → job de la cola)."
    status: active

  # llama.cpp con backend ggml-xdna (PoC NPU XDNA2 vía XRT + xclbins mlir-aie).
  # REQUIERE: XRT ≥2.21.75 (libxrt2 + libxrt-npu2 + libxrt-utils + libxrt-dev),
  # xclbins compilados (mlir-aie + Peano; uno por dimensión K del modelo) y
  # memlock unlimited. El backend solo acelera MUL_MAT; el resto va a CPU.
  llama_cpp_xdna:
    kind: llama_cpp_fork
    description: "llama.cpp fork con backend ggml-xdna (OllamaAMDNPU) — PoC NPU"
    binary: "~/opt/llama.cpp-xdna/build/bin/llama-cli"
    server: "~/opt/llama.cpp-xdna/build/bin/llama-server"
    build:
      flags: ["GGML_XDNA=ON", "GGML_BACKEND_DL=ON", "GGML_NATIVE=OFF", "BUILD_SHARED_LIBS=ON"]
      requires: ["XRT >= 2.21.75", "xclbins mlir-aie (K por modelo)", "memlock unlimited"]
    env:
      # Slots de xclbin (una entrada por K del modelo) + librería del backend.
      # Nota: en config viva usa rutas ABSOLUTAS (el env no expande ~).
      GGML_BACKEND_PATH: "~/opt/llama.cpp-xdna/build/bin/libggml-xdna.so"
      GGML_XDNA_XCLBIN_PATH: "~/opt/xclbin-prefill/k3072_n128_prefill.xclbin"
      GGML_XDNA_INSTR_PATH: "~/opt/xclbin-prefill/k3072_n128_prefill.txt"
      GGML_XDNA_TILE_M: "128"
      GGML_XDNA_TILE_K: "3072"
      GGML_XDNA_TILE_N: "128"
    capabilities:
      backends: ["npu", "cpu"]
      quant_types: ["f16", "q8_0", "q4_k_m", "k_quants"]
    quirks:
      notes: "PoC 2026-10-09 (Halo): cadena completa OK pero NO acelera — 3B XDNA 111.8pp/31.0tg vs CPU 144.5/29.2; kernels de PREFILL (decode NPU ~0.65 t/s DMA-limited, no se usa) → el path consume CPU y encima es más lento. Reproducible: mlir-aie+Peano → xclbins → cmake GGML_XDNA=ON."
    status: experimental

  # ── Otro engine con VARIANTES por backend (ejemplo): BitNet b1.58 ────────
  # Un engine puede declarar `variants:` (cuda/vulkan/cpu…): cada variante su
  # binario, `status` (verified|incompatible), `env` de ejecución, `quirks` y
  # `measured` (del PUESTO DE REFERENCIA — recalibrar por equipo).
  # `default_variant` marca la preferida; sin variante usable se sirve la
  # entrada base (y el gate de disponibilidad falla con motivo claro).
  # llama_cpp_bitnet:
  #   kind: llama_cpp_fork
  #   default_variant: cuda
  #   variants:
  #     cuda:
  #       binary: "3rdparty/BitNet-1.58b/build_cuda/bin/llama-cli"
  #       status: verified
  #     cpu:
  #       binary: "3rdparty/BitNet-1.58b/build_vulkan/bin/llama-cli"
  #       status: verified
  #       quirks: {default_ngl: 0}
  #     npu:
  #       status: incompatible
