# SEED FILE - Do not commit actual local profiles here.
# Copy this file to ~/.config/red-pill/model_profiles.yaml automatically during setup.
profiles:
  # ===============================================================
  # RECOMMENDATIONS BY TASK  (bake-off 2026-07-13, GPU RTX 5070 8 GB)
  #   scripts/distiller_bakeoff.py -> docs/BENCHMARKS/DISTILLER_BAKEOFF.md
  #   Inference runs GPU / CPU / hybrid (partial offload) — vram_tiers pick
  #   n_gpu_layers by free VRAM. GPU needs the daemon's CUDA llama-cpp.
  #
  #   distillation (sleep) -> granite_8b  [PRIMARY]  + hermes_8b [FALLBACK]
  #       Co-winners on format (4/4 JSON, Spanish, no <think>, ~1s) AND on tuned
  #       fidelity (3/3 both-sides). Granite chosen on tiebreakers: Apache-2.0
  #       license, small-expert fit, efficiency. Hermes kept as arch-risk fallback.
  #       (AD-022; docs/BENCHMARKS/DISTILLER_FIDELITY.md)
  #   distillation (Memento agentic, LONG-CONTEXT) -> tiny_aya_water [PRIMARY]
  #       RFC-002 file-based pass faces long sessions (16K+ tokens) that exceed
  #       Granite's 10240 window. Tiny Aya Water 3.35B (2 GB, 500K ctx in GGUF,
  #       served at 32K) fits a whole 16K-token session and emits disciplined
  #       refine JSON (4 relics, 2 cross_refs). gemma_3_4b = contrast lens.
  #       (bake-off 2026-09-14; docs/TECHNICAL/COGNITIVE/DISTILLER_SELECTION.md)
  #   affective/narrative  -> piaget_8b   [alternative]
  #       4/4 JSON + best 3rd-person abstraction, but emits <think> (token tax).
  #   logic / general      -> hermes_8b
  #   coding               -> coder_heavy (qwen2.5-coder)
  #
  #   NOT the distiller:
  #     qwen35_9b -> dumps a prose "Thinking Process" preamble, blows the token
  #       budget, only 1/4 parseable JSON. Great generalist; needs prompt-tuning
  #       + output stripping before it can distill.
  #     samantha  -> legacy 7B, 0/4 JSON. Retired from distillation.
  # ===============================================================

  # ── PRIMARY distiller (AD-022, jul 2026) ──────────────────────
  # Granite-4.1-8B (IBM, Apache-2.0). Co-won the bake-off on format AND fidelity;
  # chosen over Hermes on license + small-expert fit + efficiency. SOLE carrier of
  # "distillation" -> deterministic selection by the sleep cycle. Hybrid arch: if a
  # future llama.cpp fails to load it, move "distillation" to the hermes_8b fallback.
  granite_8b:
    model_path: "models/Granite-4.1-8B-Q4_K_M.gguf"
    binary_type: "gguf"
    chat_format: "chatml"
    # MEM-009 D5 (autopsia 2026-09-25): sin FA, el scratch de prefill agota el
    # headroom a n_ctx 10240 (~6.3-6.5K tokens de prompt → CUDA OOM → restart
    # loop). Con FA, 8K tokens pasan (742 MiB libres). auto|true|false.
    flash_attn: true
    # IBM Granite-4.1 — Apache-2.0. Uso comercial libre.
    license:
      id: "apache-2.0"
      commercial_ok: true
      redistribution_ok: true
      attribution_required: false
      share_alike: false
      source: "https://huggingface.co/ibm-granite/granite-4.1-8b-instruct"
    # Distiller/sleep role uses chat_format above. A request carrying tools
    # (minion role) switches to minion_chat_format on the SAME loaded model.
    # Empirically verified 2026-09-30 (daemon UDS): "chatml-function-calling"
    # emits valid OpenAI tool_calls for Granite-4.1-Q4. `null` here only means
    # "native template" for a thinking profile (Granite 4.2); a non-thinking
    # model falls back to chatml-function-calling anyway. tool_format is the
    # parser local_minion applies to tool calls emitted as TEXT.
    minion_chat_format: "chatml-function-calling"
    tool_format: "qwen"
    # Ordered device preference. First that can serve wins; if none can → 503.
    # A request may override per-task via body["device_fallback"]. igpu/npu are
    # recognised but not wired yet (skipped). cpu_n_ctx is RAM-sized, independent
    # of the VRAM tiers, and used only by the isolated CPU worker.
    device_fallback: ["gpu", "cpu"]
    cpu_n_ctx: 16384
    temperature: 0.3
    max_tokens: 4096
    use_mmap: false
    capabilities: ["distillation", "logic", "emotional_intelligence", "deep"]
    hardware_affinity:
      n_ctx: 16384
      vram_tiers:
        # Semantics (v7.18.0): the highest GPU tier whose min_free_gb FITS the
        # free VRAM wins (free >= min); the n_gpu_layers: 0 tier is the CPU
        # fallback, used only when no GPU tier fits. Scale n_ctx with free VRAM
        # to prevent context-creation crashes.
        - min_free_gb: 1.5
          n_gpu_layers: 0
          n_ctx: 16384
        - min_free_gb: 6.5
          n_gpu_layers: -1
          n_ctx: 6144
        - min_free_gb: 7.2
          n_gpu_layers: -1
          n_ctx: 10240
        - min_free_gb: 7.7
          n_gpu_layers: -1
          n_ctx: 12288
        - min_free_gb: 8.2
          n_gpu_layers: -1
          n_ctx: 16384

  # ── Granite 4.2 8B (IBM, Apache-2.0) — razonamiento nativo + tool-calling ──
  # Primera familia IBM con thinking (enable_thinking/low_effort). Template NATIVO
  # del GGUF (chat_format: null) — el chatml NO activa el razonamiento.
  # TOOL-CALLING (verificado 2026-09-30, HARNESS-004): con tools usa el template
  # nativo; el modelo emite el tool-call como TEXTO
  #   <tool_call><function=NAME><parameter=k>v</parameter></function></tool_call>
  # y `local_minion` lo parsea con model_runtime.extract_toolcalls (tool_format).
  # El parser conserva arguments como MAPPING: el template nativo renderiza
  # `tool_call.arguments|items` y un string JSON revienta el 2º turno. Los
  # resultados vuelven con rol `tool` (el template los envuelve en <tool_response>).
  # Encadena mejor que 4.1 (P3 del arnés en 6 pasos) pero muta sin confirmar bajo
  # instrucciones ambiguas → SIN autonomía no supervisada (ver arnés de autonomía).
  granite_4_2_8b:
    model_path: "models/granite-4.2-8b-Q4_K_M.gguf"
    binary_type: "gguf"
    hf_model_repo_id: "ibm-granite/granite-4.2-8b-GGUF"
    chat_format: null
    minion_chat_format: null      # null = template nativo (renderiza tools + resultados)
    tool_format: "qwen"           # parser de salida (incluye el formato <function=…>)
    thinking: "on"
    # IBM Granite-4.2 — Apache-2.0. Uso comercial libre.
    license:
      id: "apache-2.0"
      commercial_ok: true
      redistribution_ok: true
      attribution_required: false
      share_alike: false
      source: "https://huggingface.co/ibm-granite/granite-4.2-8b"
    device_fallback: ["gpu", "cpu"]
    cpu_n_ctx: 16384
    # Receta IBM 4.2 (AD-033): temp 1.0 obligatoria; top_p 0.95 = default del daemon.
    temperature: 1.0
    max_tokens: 8192
    use_mmap: false
    capabilities: ["distillation", "logic", "reasoning", "emotional_intelligence", "deep", "tool_calling"]
    hardware_affinity:
      n_ctx: 32768
      load_time_s:
        cuda: 15
        cpu: 60
        default: 60
      vram_tiers:
        # 5.35 GB pesos + KV. En 8 GB de VRAM: 8K cae holgado, 32K apurado.
        - min_free_gb: 1.5
          n_gpu_layers: 0
          n_ctx: 16384
        - min_free_gb: 6.5
          n_gpu_layers: -1
          n_ctx: 6144
        - min_free_gb: 7.2
          n_gpu_layers: -1
          n_ctx: 8192
        - min_free_gb: 7.7
          n_gpu_layers: -1
          n_ctx: 12288
        - min_free_gb: 8.2
          n_gpu_layers: -1
          n_ctx: 16384

  # ── Granite 4.2 3B (IBM, Apache-2.0) — razonamiento compacto + tool-calling ──
  # Mismo formato nativo de tool-calling que el 8B y FUNCIONA (verificado
  # 2026-09-30), pero MUCHO más verboso en el think: necesita ~1200 tokens para
  # llegar al tool-call (con 1024 se trunca a mitad de razonamiento) — el
  # max_tokens de la task/candidato debe cubrirlo.
  # Cabe 100% en GPU (2.24 GB). No usar como tool-agent con presupuesto ajustado.
  granite_4_2_3b:
    model_path: "models/granite-4.2-3b-Q4_K_M.gguf"
    binary_type: "gguf"
    hf_model_repo_id: "ibm-granite/granite-4.2-3b-GGUF"
    chat_format: null
    minion_chat_format: null
    tool_format: "qwen"
    thinking: "on"
    # IBM Granite-4.2 — Apache-2.0. Uso comercial libre.
    license:
      id: "apache-2.0"
      commercial_ok: true
      redistribution_ok: true
      attribution_required: false
      share_alike: false
      source: "https://huggingface.co/ibm-granite/granite-4.2-3b"
    device_fallback: ["gpu", "cpu"]
    cpu_n_ctx: 16384
    # Receta IBM 4.2 (AD-033): temp 1.0 obligatoria; top_p 0.95 = default del daemon.
    temperature: 1.0
    max_tokens: 8192
    use_mmap: false
    capabilities: ["distillation", "logic", "reasoning", "emotional_intelligence", "deep", "tool_calling"]
    hardware_affinity:
      n_ctx: 32768
      load_time_s:
        cuda: 5
        cpu: 20
        default: 20
      vram_tiers:
        - min_free_gb: 1.5
          n_gpu_layers: 0
          n_ctx: 16384
        - min_free_gb: 3.5
          n_gpu_layers: -1
          n_ctx: 8192
        - min_free_gb: 5.0
          n_gpu_layers: -1
          n_ctx: 16384
        - min_free_gb: 6.5
          n_gpu_layers: -1
          n_ctx: 32768

  # ── Multilingual generalist (NOT the distiller — see bake-off) ─
  # Qwen3.5-9B Instruct: Apache-2.0, 201 langs, large ctx, fits 8 GB. Strong
  # general model but ignores "no reasoning" and breaks strict JSON (1/4 in the
  # bake-off). Kept for logic/emotional tasks; promote to "distillation" only
  # after prompt-tuning to suppress the reasoning preamble.
  qwen35_9b:
    model_path: "models/Qwen3.5-9B-Q4_K_M.gguf"
    binary_type: "gguf"
    chat_format: "chatml"
    # Qwen — Apache-2.0. Uso comercial libre.
    license:
      id: "apache-2.0"
      commercial_ok: true
      redistribution_ok: true
      attribution_required: false
      share_alike: false
      source: "https://huggingface.co/Qwen"
    temperature: 0.3
    max_tokens: 4096
    use_mmap: false
    capabilities: ["logic", "emotional_intelligence", "deep"]
    hardware_affinity:
      n_ctx: 32768
      vram_tiers:
        # Tuned for the RTX 5070 8 GB shared with training. An 8-9B Q4 with a large
        # KV cache only fits when the GPU is essentially idle; partial offload crashes
        # context creation while training holds VRAM (the 3028-error storm of 2026-07-16).
        # Semantics (v7.18.0): highest GPU tier that fits (free >= min) wins;
        # the n_gpu_layers: 0 tier is the CPU fallback when no GPU tier fits.
        - min_free_gb: 1.5
          n_gpu_layers: 0
        - min_free_gb: 7
          n_gpu_layers: -1

  # ── Bake-off candidate: domain-specialist distiller ───────────
  # Beck-8B (finetune of Piaget-8B = Qwen3-8B + LoRA on psychology/philosophy
  # reasoning traces). Strong affective/narrative judgment for the culling
  # role. Promote by moving "distillation" here after the bake-off
  # (see .red-pill/memory/PLAN_MEMORY_REMEDIATION.md, Hito 4a-bis).
  beck_8b:
    model_path: "models/Beck-8B-Q4_K_M.gguf"
    binary_type: "gguf"
    chat_format: "chatml"
    # Finetune of Piaget-8B (Qwen3-8B base) — Apache-2.0. Uso comercial libre.
    license:
      id: "apache-2.0"
      commercial_ok: true
      redistribution_ok: true
      attribution_required: false
      share_alike: false
      source: "https://huggingface.co/Qwen"
    temperature: 0.3
    max_tokens: 4096
    use_mmap: false
    capabilities: ["logic", "emotional_intelligence", "deep"]
    hardware_affinity:
      n_ctx: 16384
      vram_tiers:
        # Tuned for the RTX 5070 8 GB shared with training. An 8-9B Q4 with a large
        # KV cache only fits when the GPU is essentially idle; partial offload crashes
        # context creation while training holds VRAM (the 3028-error storm of 2026-07-16).
        # Semantics (v7.18.0): highest GPU tier that fits (free >= min) wins;
        # the n_gpu_layers: 0 tier is the CPU fallback when no GPU tier fits.
        - min_free_gb: 1.5
          n_gpu_layers: 0
        - min_free_gb: 7
          n_gpu_layers: -1

  # ── Alternative distiller: affective/narrative depth ──────────
  # Piaget-8B (Qwen3-8B + LoRA on 15k psychology/philosophy reasoning traces).
  # Bake-off: 4/4 JSON + the best 3rd-person abstraction of the field, but emits
  # <think> blocks (token tax). Choose over hermes_8b if emotional nuance matters
  # more than the overhead. Beck-8B (its finetune) copied input verbatim on the
  # emotional probe — Piaget abstracts better, so it is preferred of the two.
  piaget_8b:
    model_path: "models/Piaget-8B-Q4_K_M.gguf"
    binary_type: "gguf"
    chat_format: "chatml"
    # Finetune of Qwen3-8B — Apache-2.0. Uso comercial libre.
    license:
      id: "apache-2.0"
      commercial_ok: true
      redistribution_ok: true
      attribution_required: false
      share_alike: false
      source: "https://huggingface.co/Qwen"
    temperature: 0.3
    max_tokens: 4096
    use_mmap: false
    capabilities: ["logic", "emotional_intelligence", "deep"]
    hardware_affinity:
      n_ctx: 16384
      vram_tiers:
        # Tuned for the RTX 5070 8 GB shared with training. An 8-9B Q4 with a large
        # KV cache only fits when the GPU is essentially idle; partial offload crashes
        # context creation while training holds VRAM (the 3028-error storm of 2026-07-16).
        # Semantics (v7.18.0): highest GPU tier that fits (free >= min) wins;
        # the n_gpu_layers: 0 tier is the CPU fallback when no GPU tier fits.
        - min_free_gb: 1.5
          n_gpu_layers: 0
        - min_free_gb: 7
          n_gpu_layers: -1

  # ── FALLBACK distiller / primary "logic" (AD-022) ─────────────
  # Hermes-3-Llama-3.1-8B. Classic Llama arch (always loads, no <think> tax).
  # Bake-off co-winner (4/4 format + 3/3 tuned fidelity); lost the tiebreaker to
  # granite_8b on license (Llama-3.1 vs Apache-2.0). Kept as the arch-risk fallback
  # and primary "logic" model; promote to "distillation" if granite fails to load.
  hermes_8b:
    model_path: "models/Hermes-3-Llama-3.1-8B.Q4_K_M.gguf"
    binary_type: "gguf"
    chat_format: "chatml"
    # NousResearch Hermes-3 — Apache-2.0. Uso comercial libre.
    license:
      id: "apache-2.0"
      commercial_ok: true
      redistribution_ok: true
      attribution_required: false
      share_alike: false
      source: "https://huggingface.co/NousResearch/Hermes-3-Llama-3.1-8B"
    temperature: 0.3
    max_tokens: 4096
    use_mmap: false
    capabilities: ["logic", "emotional_intelligence", "deep"]
    hardware_affinity:
      n_ctx: 16384
      # vram_tiers are keyed by FREE VRAM at load time (VramProbe.get_free_mb(),
      # not total installed). Tier selection is monotonic: more free VRAM → higher
      # tier → more n_gpu_layers. Keep partial-offload tiers OUT on an 8 GB card
      # shared with training — they crash context creation (see the block comment).
      vram_tiers:
        # Semantics (v7.18.0): the highest GPU tier whose min_free_gb FITS the
        # free VRAM wins (free >= min); the n_gpu_layers: 0 tier is the CPU
        # fallback, used only when no GPU tier fits. Scale n_ctx with free VRAM
        # to prevent context-creation crashes.
        - min_free_gb: 1.5
          n_gpu_layers: 0
          n_ctx: 16384
        - min_free_gb: 6.5
          n_gpu_layers: -1
          n_ctx: 6144
        - min_free_gb: 7.2
          n_gpu_layers: -1
          n_ctx: 10240
        - min_free_gb: 7.7
          n_gpu_layers: -1
          n_ctx: 12288
        - min_free_gb: 8.2
          n_gpu_layers: -1
          n_ctx: 16384

  # ── Legacy: Samantha-Mistral-7B ────────────────────────────────
  # Kept for operators who prefer the original empathy-tuned model.
  # Does NOT carry "logic" capability — will not be auto-selected by
  # samantha_on_demand.py unless explicitly set via MINION_PROFILE.
  samantha:
    model_path: "experimental/Samantha/samantha-mistral-instruct-7b.i1-Q4_K_M.gguf"
    binary_type: "gguf"
    chat_format: "chatml"
    # Samantha (Eric Hartford / QuixiAI) — Apache-2.0. Uso comercial libre.
    license:
      id: "apache-2.0"
      commercial_ok: true
      redistribution_ok: true
      attribution_required: false
      share_alike: false
      source: "https://huggingface.co/QuixiAI/samantha-mistral-instruct-7b"
    temperature: 0.7
    max_tokens: 1024
    use_mmap: false
    capabilities: ["emotional_intelligence", "deep"]
    hardware_affinity:
      n_ctx: 4096
      vram_tiers:
        # 7B with a small context (4k): needs ~6 GB free to offload fully on the
        # 8 GB card. Semantics (v7.18.0): highest GPU tier that fits (free >= min)
        # wins; the n_gpu_layers: 0 tier is the CPU fallback when no GPU tier fits.
        - min_free_gb: 1.5
          n_gpu_layers: 0
        - min_free_gb: 6
          n_gpu_layers: -1

  smith:
    model_path: "3rdparty/BitNet-1.58b/models/2B-4T/ggml-model-i2_s.gguf"
    binary_type: "bitnet"
    # BitNet-2B-4T — MIT. Uso comercial libre.
    license:
      id: "mit"
      commercial_ok: true
      redistribution_ok: true
      attribution_required: true
      share_alike: false
      source: "https://huggingface.co/HF1BitLLM/Llama3-2-1B-1.58-4bit"
    temperature: 0.0
    max_tokens: 512
    grammar_path: "3rdparty/BitNet-1.58b/validation/json.gbnf"
    use_mmap: false
    capabilities: ["logic", "fast", "coding"]

  # ── Memento agentic-pass distiller/curator (bake-off 2026-09-14) ──────
  # Tiny Aya Water 3.35B (CohereLabs). RFC-002's file-based pass faces LONG
  # sessions that exceed Granite's 10240 window; this 2 GB model carries a
  # large context (500K in GGUF, served at 32K) and fits a 16K-token session
  # whole. European-language variant → Spanish fidelity; disciplined refine
  # JSON (4 relics, 2 cross_refs). Set MINION_PROFILE=tiny_aya_water for the
  # Memento pass. NOT a replacement of granite_8b as the sleep distiller.
  # Language flavours (Cohere Labs official): earth = Africa & West Asia;
  # fire = South Asian; water = Asia-Pacific & Europe (this one); global =
  # best overall balance. Pick by the operator's language family.
  tiny_aya_water:
    model_path: "models/tiny-aya-water-q4_k_m.gguf"
    binary_type: "gguf"
    hf_model_repo_id: "CohereLabs/tiny-aya-water-GGUF"
    chat_format: "chatml"
    # ⛔ CohereLabs Tiny Aya Water — CC-BY-NC-4.0. NO COMERCIAL.
    # El compliance gate lo BLOQUEA cuando REDPILL_LICENSE_CONTEXT=commercial
    # (máquina del trabajo). En personal (default) se permite. Requiere atribución.
    license:
      id: "cc-by-nc-4.0"
      commercial_ok: false
      redistribution_ok: true
      attribution_required: true
      share_alike: true
      source: "https://huggingface.co/CohereLabs/tiny-aya-water"
    device_fallback: ["gpu", "cpu"]
    cpu_n_ctx: 16384
    prompt_file: "distiller_v3_voice.txt"
    temperature: 0.3
    max_tokens: 4096
    use_mmap: false
    capabilities: ["distillation", "logic", "multilingual", "emotional_intelligence", "long_context"]
    hardware_affinity:
      n_ctx: 32768
      vram_tiers:
        # 2.0 GB weights + KV. 8K ≈ 3.2 GB, 32K ≈ 6.3 GB (measured RTX 5070).
        - min_free_gb: 1.5
          n_gpu_layers: 0
          n_ctx: 16384
        - min_free_gb: 4.0
          n_gpu_layers: -1
          n_ctx: 8192
        - min_free_gb: 7.0
          n_gpu_layers: -1
          n_ctx: 32768

  # ===============================================================
  # ESQUEMA: plan de KV por calidad (RFC-HARNESS-003 §2.7)
  # ---------------------------------------------------------------
  # Un perfil puede declarar la calibración MEDIDA de su equipo:
  #   kv_cache.bytes_per_token_kib: coste de KV por token y calidad — se mide
  #     cargando el modelo y anotando el KV buffer del equipo (NO copiar de otro).
  #   vram_footprint: pesos reales en VRAM + overhead (workspaces) del equipo.
  # El resolver conserva `hardware_affinity.n_ctx` (contexto deseado) y elige la
  # mejor KV que quepa (f16 → q8_0 → q4_0); sin estos datos cae al paradigma
  # legacy (tiers de n_ctx por VRAM libre).
  #
  # Ejemplo (valores del PUESTO DE REFERENCIA — RECALIBRAR por equipo):
  #   perfil_ejemplo:
  #     model_path: "/ruta/al/modelo.gguf"
  #     kv_cache:
  #       preferred: f16
  #       fallbacks: ["q8_0", "q4_0"]
  #       bytes_per_token_kib: {f16: 64, q8_0: 34, q4_0: 18}
  #     vram_footprint:
  #       weights_mb: 5536
  #       overhead_mb: 330
  #
  # Nota de anclaje de runtime (RFC-HARNESS-003): un perfil puede declarar
  # `runtime: <id>` (ver runtimes.yaml.example); sin campo, usa el default.
  # ===============================================================

  # ===============================================================
  # NPU (FastFlowLM / XDNA2) — EJEMPLOS (medidas del PUESTO DE REFERENCIA,
  # 2026-10-09 — recalibrar por equipo)
  # ---------------------------------------------------------------
  # Campos específicos del runner FLM:
  #   model_tag         tag del catálogo `flm` (p.ej. gpt-oss:20b)
  #   serve_args        argumentos extra de `flm serve` (p.ej. --ctx-len; el
  #                     server por defecto va a ~8K → subir para needles largos)
  #   request_params    se fusionan en el body OpenAI (reasoning_effort,
  #                     temperature…); gpt-oss honra reasoning_effort a veces
  #   output_budget     tope de salida por perfil, ACOTADO al ctx servido
  #                     (fórmula ctx−prompt−256: nunca desborda ni OOM por salida)
  #   two_phase         {summary_words: N} — prototipo pensar→resumen fijo→
  #                     responder (THINK-KV-001; no rindió en gpt-oss)
  # Calidad medida (benchset v1): 9B 6/6 · 35B-MoE 5/6 · gemma4-12b 5/6
  # (visión ✓) · gpt-oss 1/6 (thinking harmony se come la salida).
  # Los modelos FLM persisten en ~/.config/flm/models (pull una vez).
  # ===============================================================

  npu_gpt_oss_20b:
    model_path: ~/.config/flm/models/GPT-OSS-20B-NPU2
    binary_type: fastflowlm
    model_tag: gpt-oss:20b
    runtime: "fastflowlm"
    serve_args: ["--ctx-len", "16384"]
    request_params: {reasoning_effort: low}
    output_budget: 12288
    temperature: 0.7
    capabilities: ["reasoning", "logic", "multilingual", "npu"]
    hardware_affinity:
      backend: npu
      device: /dev/accel/accel0
      ram_gb: 14

  npu_gemma4_12b:
    model_path: ~/.config/flm/models/Gemma4-12B-NPU2
    binary_type: fastflowlm
    model_tag: gemma4-it:12b
    runtime: "fastflowlm"
    temperature: 0.7
    capabilities: ["reasoning", "multilingual", "npu", "vision", "audio"]
    hardware_affinity:
      backend: npu
      device: /dev/accel/accel0
      ram_gb: 9

  # Perfil sobre el runtime ggml-xdna (PoC — NO acelera; ver runtimes.yaml.example).
  # Sirve para medir CALIDAD del path/kernels, no rendimiento.
  llama_32_xdna:
    model_path: "models/Llama-3.2-3B-Instruct-Q4_K_M.gguf"
    binary_type: "gguf"
    runtime: "llama_cpp_xdna"
    device_fallback: ["npu", "cpu"]
    temperature: 0.3
    capabilities: ["logic", "npu", "xdna-poc"]
