{
  "$id": "azrael://swarm_team/v3/implementor_result",
  "type": "object",
  "required": [
    "role",
    "phase_id",
    "status",
    "changes",
    "commands_run",
    "assumptions"
  ],
  "additionalProperties": false,
  "properties": {
    "role": {
      "const": "implementor"
    },
    "phase_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "DONE",
        "PARTIAL",
        "FAILED"
      ],
      "description": "ADVISORY: el estado oficial de la fase lo determina el ciclo Validar→Smoke→Panel, no el Implementador."
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "created",
              "modified",
              "deleted",
              "renamed"
            ]
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "commands_run": {
      "type": "array",
      "description": "Comandos ejecutados durante la implementación (builds, tests locales...) con su output real.",
      "items": {
        "$ref": "#/$defs/Evidence"
      }
    },
    "assumptions": {
      "type": "array",
      "description": "REGLA 2: TODA asunción técnica se declara. Nacen siempre en estado ASSUMED; las verifica otro rol.",
      "items": {
        "type": "object",
        "required": [
          "statement",
          "criticality"
        ],
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 10
          },
          "criticality": {
            "enum": [
              "low",
              "medium",
              "critical"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "fail_reason": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance",
      "description": "v3.1: execution origin (harness/provider/model/timestamp). Emitted by the role, or STAMPED by the orchestrator at consolidation when the role did not emit it — a report never lands in the ledger without provenance."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "PARTIAL",
              "FAILED"
            ]
          }
        }
      },
      "then": {
        "required": [
          "fail_reason"
        ]
      }
    }
  ],
  "$defs": {
    "Evidence": {
      "type": "object",
      "required": [
        "command",
        "exit_code",
        "output_excerpt"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "cwd": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "output_excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "output_full_path": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer"
        },
        "timestamp": {
          "type": "string"
        }
      }
    },
    "Provenance": {
      "type": "object",
      "required": [
        "harness",
        "timestamp"
      ],
      "properties": {
        "harness": {
          "type": "string",
          "enum": [
            "opencode",
            "claude-code",
            "codex",
            "agy",
            "local",
            "antigravity",
            "kimi",
            "other"
          ],
          "description": "Client/harness that executed this role"
        },
        "provider": {
          "type": "string",
          "description": "Model provider (anthropic, openai, google, deepseek, azure, ollama...)"
        },
        "model": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "description": "Harness or bundle version"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO-8601"
        }
      }
    }
  }
}
