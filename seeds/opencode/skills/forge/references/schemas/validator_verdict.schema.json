{
  "$id": "redpill://forge/v3/validator_verdict",
  "type": "object",
  "required": [
    "role",
    "phase_id",
    "verdict",
    "criteria_results",
    "assumptions_raised"
  ],
  "additionalProperties": false,
  "properties": {
    "role": {
      "const": "validator"
    },
    "phase_id": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL"
      ],
      "description": "ADVISORY. El Workflow/gate recomputa: PASS solo si TODOS los criteria_results son PASS."
    },
    "criteria_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "criterion_id",
          "description",
          "verdict"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "pattern": "^C-\\d+$"
          },
          "description": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "PASS",
              "FAIL",
              "PENDING_HUMAN"
            ]
          },
          "evidence": {
            "$ref": "#/$defs/Evidence"
          },
          "fail_reason": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "verdict": {
                  "const": "PASS"
                }
              }
            },
            "then": {
              "required": [
                "evidence"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "verdict": {
                  "const": "FAIL"
                }
              }
            },
            "then": {
              "required": [
                "fail_reason",
                "evidence"
              ]
            }
          }
        ]
      }
    },
    "assumptions_raised": {
      "type": "array",
      "description": "Ambigüedades detectadas durante la validación; se escalan al Devil's Advocate.",
      "items": {
        "type": "object",
        "required": [
          "statement",
          "criticality"
        ],
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 10
          },
          "criticality": {
            "enum": [
              "low",
              "medium",
              "critical"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "$ref": "#/$defs/Provenance",
      "description": "v3.1: execution origin (harness/provider/model/timestamp). Emitted by the role, or STAMPED by the orchestrator at consolidation when the role did not emit it — a report never lands in the ledger without provenance."
    }
  },
  "$defs": {
    "Evidence": {
      "type": "object",
      "required": [
        "command",
        "exit_code",
        "output_excerpt"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "cwd": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "output_excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "output_full_path": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer"
        },
        "timestamp": {
          "type": "string"
        }
      }
    },
    "Provenance": {
      "type": "object",
      "required": [
        "harness",
        "timestamp"
      ],
      "properties": {
        "harness": {
          "type": "string",
          "enum": [
            "opencode",
            "claude-code",
            "codex",
            "agy",
            "local",
            "antigravity",
            "kimi",
            "other"
          ],
          "description": "Client/harness that executed this role"
        },
        "provider": {
          "type": "string",
          "description": "Model provider (anthropic, openai, google, deepseek, azure, ollama...)"
        },
        "model": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "description": "Harness or bundle version"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO-8601"
        }
      }
    }
  }
}
