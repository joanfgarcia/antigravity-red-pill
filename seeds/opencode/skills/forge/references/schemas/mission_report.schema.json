{
  "$id": "redpill://forge/v3/mission_report",
  "type": "object",
  "$comment": "MODO MISIÓN — Informe final. El veredicto ejecutivo es ADVISORY: gate-check.mjs lo recomputa desde state.json. Lo que el Operador recibe al volver.",
  "required": [
    "mission",
    "verdict",
    "plan_coverage",
    "blocks",
    "decisions",
    "debt",
    "pending_human",
    "totals"
  ],
  "additionalProperties": false,
  "properties": {
    "mission": {
      "type": "string",
      "description": "Nombre de la misión (p.ej. 'Refactor brain — plan v2.1')"
    },
    "plan_ref": {
      "type": "string",
      "description": "Path al plan ancla"
    },
    "verdict": {
      "enum": [
        "COMPLETE",
        "COMPLETE_WITH_PENDING",
        "PARTIAL"
      ],
      "description": "ADVISORY, recomputado por gate-check: COMPLETE = 100% cubierto y 0 pendientes; COMPLETE_WITH_PENDING = 100% de lo ejecutable, resto documentado en pending_human; PARTIAL = quedó deuda no resuelta."
    },
    "plan_coverage": {
      "type": "object",
      "required": [
        "total_points",
        "covered",
        "pending_human",
        "blocked"
      ],
      "properties": {
        "total_points": {
          "type": "integer",
          "minimum": 0
        },
        "covered": {
          "type": "integer",
          "minimum": 0
        },
        "pending_human": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "blocks": {
      "type": "array",
      "description": "Un elemento por bloque de fases ejecutado (3-5 fases por bloque)",
      "items": {
        "type": "object",
        "required": [
          "block_id",
          "phases",
          "status"
        ],
        "properties": {
          "block_id": {
            "type": "string"
          },
          "phases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "DONE",
              "DONE_WITH_DEBT",
              "PARTIAL"
            ]
          },
          "workflow_run_id": {
            "type": "string"
          },
          "iterations_total": {
            "type": "integer"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "description": "Todas las decisiones autónomas tomadas (schema decision) para revisión a posteriori del Operador",
      "items": {
        "type": "object"
      }
    },
    "debt": {
      "type": "array",
      "description": "Deuda de misión residual tras el barrido final: fases/puntos que agotaron la escalera anti-abandono",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "attempts_summary",
          "diagnosis"
        ],
        "properties": {
          "ref": {
            "type": "string"
          },
          "attempts_summary": {
            "type": "string",
            "description": "Todo lo que el equipo intentó, con evidencia"
          },
          "diagnosis": {
            "type": "string"
          }
        }
      }
    },
    "pending_human": {
      "type": "array",
      "description": "Sección 'Requiere tu intervención': lo ÚNICO que el Operador debe hacer",
      "items": {
        "type": "object",
        "required": [
          "item",
          "why_blocked",
          "instructions"
        ],
        "properties": {
          "item": {
            "type": "string"
          },
          "why_blocked": {
            "type": "string",
            "description": "Por qué el equipo no pudo (credencial, acción irreversible fuera del plan, UI humana...)"
          },
          "instructions": {
            "type": "string",
            "minLength": 20,
            "description": "Pasos exactos, resolubles en minutos"
          },
          "estimated_minutes": {
            "type": "integer"
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "required": [
        "pass",
        "fail",
        "pending_human"
      ],
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "pending_human": {
          "type": "integer",
          "minimum": 0
        },
        "assumptions_verified": {
          "type": "integer"
        },
        "assumptions_disproven": {
          "type": "integer"
        },
        "budget_spent_tokens": {
          "type": "integer"
        }
      }
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "$ref": "#/$defs/Provenance",
      "description": "v3.1: execution origin (harness/provider/model/timestamp). Emitted by the role, or STAMPED by the orchestrator at consolidation when the role did not emit it — a report never lands in the ledger without provenance."
    }
  },
  "$defs": {
    "Provenance": {
      "type": "object",
      "required": [
        "harness",
        "timestamp"
      ],
      "properties": {
        "harness": {
          "type": "string",
          "enum": [
            "opencode",
            "claude-code",
            "codex",
            "agy",
            "local",
            "antigravity",
            "kimi",
            "other"
          ],
          "description": "Client/harness that executed this role"
        },
        "provider": {
          "type": "string",
          "description": "Model provider (anthropic, openai, google, deepseek, azure, ollama...)"
        },
        "model": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "description": "Harness or bundle version"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO-8601"
        }
      }
    }
  }
}
