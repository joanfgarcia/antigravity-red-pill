{
  "$id": "azrael://swarm_team/v3/qa_final",
  "type": "object",
  "required": [
    "role",
    "verdict",
    "totals",
    "tests",
    "preconditions"
  ],
  "additionalProperties": false,
  "properties": {
    "role": {
      "const": "qa_final"
    },
    "verdict": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "BLOCKED"
      ],
      "description": "ADVISORY. gate-check.mjs lo recomputa desde state.json: COMPLETE exige 0 ASSUMED, 0 SIN_CUBRIR, 0 FAIL sin fix."
    },
    "totals": {
      "type": "object",
      "required": [
        "pass",
        "fail",
        "pending_human"
      ],
      "description": "REGLA 5 (Fail-Fast Honesty): SIEMPRE los 3 números. Mejor 45/55 PASS + 10 PENDING que mentir con 55/55.",
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "pending_human": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "preconditions": {
      "type": "object",
      "required": [
        "assumptions_open",
        "coverage_uncovered"
      ],
      "description": "Leídas de state.json ANTES de testear. Si >0 se reporta de inmediato.",
      "properties": {
        "assumptions_open": {
          "type": "integer",
          "minimum": 0
        },
        "coverage_uncovered": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "expected",
          "verdict"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(T|ST)-\\d+$"
          },
          "type": {
            "enum": [
              "unit",
              "integration",
              "config_parse",
              "api_mcp_call",
              "script_exec",
              "ui",
              "integration_e2e",
              "env_parity"
            ]
          },
          "description": {
            "type": "string"
          },
          "evidence": {
            "$ref": "#/$defs/Evidence"
          },
          "expected": {
            "type": "string"
          },
          "observed": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "PASS",
              "FAIL",
              "PENDING_HUMAN"
            ]
          },
          "human_instructions": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "verdict": {
                  "enum": [
                    "PASS",
                    "FAIL"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "evidence",
                "observed"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "verdict": {
                  "const": "PENDING_HUMAN"
                }
              }
            },
            "then": {
              "required": [
                "human_instructions"
              ]
            }
          }
        ]
      }
    },
    "pending_human": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "test_id",
          "instructions"
        ],
        "properties": {
          "test_id": {
            "type": "string"
          },
          "instructions": {
            "type": "string",
            "minLength": 20,
            "description": "Pasos exactos, ejecutables por el Operador en minutos"
          }
        }
      }
    },
    "provenance": {
      "$ref": "#/$defs/Provenance",
      "description": "v3.1: execution origin (harness/provider/model/timestamp). Emitted by the role, or STAMPED by the orchestrator at consolidation when the role did not emit it — a report never lands in the ledger without provenance."
    }
  },
  "$defs": {
    "Evidence": {
      "type": "object",
      "required": [
        "command",
        "exit_code",
        "output_excerpt"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "cwd": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "output_excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "output_full_path": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer"
        },
        "timestamp": {
          "type": "string"
        }
      }
    },
    "Provenance": {
      "type": "object",
      "required": [
        "harness",
        "timestamp"
      ],
      "properties": {
        "harness": {
          "type": "string",
          "enum": [
            "opencode",
            "claude-code",
            "codex",
            "agy",
            "local",
            "antigravity",
            "kimi",
            "other"
          ],
          "description": "Client/harness that executed this role"
        },
        "provider": {
          "type": "string",
          "description": "Model provider (anthropic, openai, google, deepseek, azure, ollama...)"
        },
        "model": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "description": "Harness or bundle version"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO-8601"
        }
      }
    }
  }
}
