# Red Pill Bünker Config (v8.0.0)
# Copy this file to .env and adjust as needed.

# SEC-PURGE-001: Emergency override to enable 'red-pill purge'.
# Blocked by default to prevent accidental mass deletion.
# Only set to 'true' during a controlled maintenance window.
ALLOW_PURGE=false

# Antigravity conversation decryption key (base64-encoded AES key).
# Required by chronicle_daily.py for the automated chronicle pipeline.
# If missing or expired: see docs/TECHNICAL/ANTIGRAVITY_KEY_RECOVERY.md
ANTIGRAVITY_KEY=

# --- Agentic Self-Assembly Architecture ---
# WORKSPACE_ROOT = red-pill's OWN ecosystem/asset root (dev downloads, models, backups, versions).
# It is NOT a project workspace. Your PROJECT workspaces (peers) and their per-project atlas live in
# the workspace registry: ~/.config/red-pill/workspaces.yaml (template: examples/workspaces.yaml).
WORKSPACE_ROOT=~/Documents/IA
APP_ROOT=${WORKSPACE_ROOT}/red-pill
RED_PILL_PROFILE=user
# AGENT_CORE_DIR = the agent's GLOBAL personal desk (transversal). The effective source for IDE
# anchors is workspaces.yaml:agent_core. (USER_ATLAS_DIR removed: the atlas is per-project now.)
AGENT_CORE_DIR=${WORKSPACE_ROOT}/Agent_Core

# AWAKENING_PLANNER_ACCESS = qué puede tocar el agente en el desk durante un despertar
# autónomo (política personal del puesto). Zonas separadas por comas: ideas, research,
# design, pending, in_progress, awakening. "planner" = todas las de planificación;
# "none" = no contribuir al planner (solo registra su log).
# AWAKENING_PLANNER_ACCESS=planner

# --- Qdrant Settings ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_SCHEME=http
# [NEW v4.0.7] API Key for Qdrant (Optional but recommended for shared environments)
# QDRANT_API_KEY=your-secret-api-key

# ==========================================
# (5) MCP Configurations
# ==========================================
# Determines the noise filter for the interceptor (Low=0.5, High=0.75)
SEMANTIC_INTENT_THRESHOLD=Low
# Enables or disables the global MCP Interceptor RP tool (Defaults to False for privacy/security)
INTERCEPTOR_ENABLED=False
INTERCEPTOR_RAG_ENABLED=True
INTERCEPTOR_CIRCUIT_BREAKER_ENABLED=False
# [NEW] Mood Orchestrator: consolidates plugins 05-09 into a single pass
# When True, orchestrator loads all subplugins (each checks its own flag internally)
MOOD_ORCHESTRATOR_ENABLED=True

# --- Engine Brake Vocabularies (Ferrari 05/06) ---
# Operator-customizable, comma-separated, matched as lowercase substrings.
# Tune them to YOUR language and trade: a designer's work words are not a
# netrunner's. Uncomment and edit — these are the shipped defaults.
# WORK_MODE_KEYWORDS="arregla,fix,implementa,implement,modo trabajo,work mode,trabaja,ejecuta,execute,despliega,deploy,haz un,crea un,create a,build the,commit,push,refactor,refactoriza,debug,depura,compila,compile,testea"
# CASUAL_OVERRIDE_KEYWORDS="charlemos,charlar,charla,relax,relajado,hablemos,conversemos,off-topic,chill,quemar tokens,de guardia,no hay prisa"

# --- OpenCode bridge (swarm cascade) ---
# Explicit path to the `opencode` binary. Wins over PATH resolution — the
# robust option for service-manager contexts (systemd/launchd/Task Scheduler).
# OPENCODE_BIN="/home/you/.opencode/bin/opencode"
# URL of a persistent `opencode serve` instance (attached mode, no MCP cold-start).
# OPENCODE_SERVER_URL="http://localhost:4096"
# Set to true when the redpill-scribe OpenCode plugin handles persistence
# (disables the bridge's _scribe_relay to avoid double-writes).
# OPENCODE_SCRIBE_PLUGIN=false

# --- Telegram execution cascade (RFC_TELEGRAM_RESILIENCE) ---
# Ordered fallback cascade for Telegram/inbox processing. The worker tries each
# target in order and uses the first with quota; if all fail the pertinent error
# is surfaced to the user. Per-target optional fields: backend, model, effort,
# timeout (overrides the method timeout for that target).
# The primario (pro) SHOULD carry a generous timeout (300s+): the method default
# TELEGRAM_INLINE_TIMEOUT is 120s and would otherwise be an aggressive kill
# (D14). The fallback to the free tier must NOT be an opencode-go/* model (same
# Go subscription) — use the opencode/* free tier.
# TELEGRAM_BRIDGE_CASCADE='[{"backend":"opencode","model":"opencode-go/deepseek-v4-pro","timeout":300},{"backend":"opencode","model":"opencode/deepseek-v4-flash-free"}]'
# TELEGRAM_INLINE_TIMEOUT=120
# TELEGRAM_FALLBACK_TIMEOUT=300  # (Fase 2) inline fallback when the queue is down

# --- Model Configuration ---
# FastEmbed model. Multilingual (ES/EN), 384-dim. Changing this REQUIRES
# recomputing stored vectors: run scripts/reembed_collections.py --execute
# (same 384 dims → no schema change, but old vectors are stale until re-embedded).
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# [NEW v4.0.7] Vector dimensions. Must match the model.
VECTOR_SIZE=384

# --- B760-Adaptive Logic ---
# Decay Strategy: 'linear' (default) or 'exponential'
DECAY_STRATEGY=linear
# How much reinforcement score to subtract per erosion cycle
EROSION_RATE=0.05
# Score increment per search hit
REINFORCEMENT_INCREMENT=0.1
# How much score propagates to associated engrams (0.5 = 50% of increment)
PROPAGATION_FACTOR=0.5
# Score at which an engram becomes permanently immune to erosion
IMMUNITY_THRESHOLD=10.0
# [NEW v4.1.0] Custom triggers to automatically activate Deep Recall (comma-separated).
# Note: 'despierta' and 'wake up' are immune symbiosis triggers and are always added implicitly.
DEEP_RECALL_TRIGGERS="don't you remember,¿no te acuerdas?,deep recall,try hard!"

# --- Reactive Debounce (Compaction sliding window for Telegram messages) ---
# Enable to accumulate bursts of fast Telegram messages into a single prompt.
REACTIVE_DEBOUNCE_ENABLED=false
# Debounce window in seconds before executing the compiled prompt.
REACTIVE_DEBOUNCE_SECONDS=5

# --- Memento Chronicle (RFC-002) ---
# Memento-only extra sources. memory_queue = MCP-only turns (MUST 10, default).
# antigravity_export = frozen early-era snapshot (47 MD, 2026-03-23) at
# ~/.gemini/antigravity/conversations_export — operator legacy, opt-in:
# MEMENTO_EXTRA_SOURCES=memory_queue,antigravity_export
# Default: memory_queue only (clean installs have no snapshot).
# MEMENTO_EXTRA_SOURCES=memory_queue

# --- Memento recall (feedback 2026-09-25; RULE 4: one flag per piece, default OFF) ---
# Hybrid recall: semantic (Qdrant) + keywords over the Memento tree, fused by RRF.
# Only explicit callers (oracle / CLI search), never the handshake interceptors.
# MEMORY_HYBRID_RECALL_ENABLED=true
# MMR diversity of the top-k (keeps paraphrases of one fact from filling it).
# MEMORY_RECALL_MMR_ENABLED=true
# MEMORY_RECALL_MMR_LAMBDA=0.85
# Annotate: dedup AFTER the voice rewrite (exact + tokens + embedding near-dups).
# MEMENTO_ANNOTATE_POST_REWRITE_DEDUP=true
# Annotate voice v2 (subject = who acted, no "Joan me..." opener, name the entity).
# Changes the annotate fingerprint → annotated sessions go stale for the rebuild.
# MEMENTO_ANNOTATE_VOICE_V2=false
# View of the RAW fragment seen by annotate (the tree is untouched):
# raw (as rendered) | actors (actor on every turn) | pairs (operator + agent's final reply only).
# MEMENTO_ANNOTATE_FRAGMENT_VIEW=raw
# MEMENTO_OPERATOR_LABEL=Joan
# MEMENTO_AGENT_LABEL=Aleth
# Idioma de los textos del pase Memento (PROMPT-001): auto = idioma de la fuente
# (deja interpretar al modelo); es/en/ca/fr... fuerzan uno. Cambia la firma de los
# prompts → las sesiones quedan stale para el rebuild.
# MEMENTO_PROMPT_LANGUAGE=auto
# Scope of the WORK/SOCIAL curator axes (voice v2.1). What counts as "work"
# depends on the operator's craft: for a software engineer, his own legal/labour
# affairs are personal life (SOCIAL); a lawyer would move "legal" into WORK.
# MEMENTO_WORK_SCOPE="the operator's technical craft — code, systems, configuration, tests, architecture, infrastructure, tooling, engineering and product decisions"
# MEMENTO_SOCIAL_SCOPE="the operator's personal life — bond, emotions, identity, biography, relationships, family, health, and his own personal affairs even when formal or serious: legal, labour/HR, employment contracts, housing, personal finances, bureaucracy"
# Enriched embedding text for curated engrams (theme · relics · body). Measured on
# the recall bench: WORSE than plain (8/13 vs 9/13 hit@3) — keep OFF.
# MEMENTO_EMBED_ENRICHED=false

# --- Metabolism & Absence Guard ---
# If the bunker has been idle for more than this many seconds, a TTL refresh
# is triggered before erosion to prevent mass-deletion after long absences.
# Default: 3 days (259200) — a long weekend already arms the guard. Note the
# hourly pulse Absence Guard also refreshes TTL unconditionally; this threshold
# is the secondary erosion net.
ABSENCE_THRESHOLD=259200
# Comma-separated collections for automatic metabolism (erosion/refresh)
METABOLISM_AUTO_COLLECTIONS=work_memories,social_memories,story_memories
METABOLISM_ENABLED=True
# Max characters per chunk the sleep cycle feeds to the distiller. With the
# default distiller granite_8b (n_ctx 16384) 6000 chars leaves ample room for
# the summary; with legacy Samantha (4096) keep it <=1000.
SLEEP_CHUNK_SIZE=6000
# When False (default), a search never DELETES eroded engrams — it only hides
# them from the result. Forgetting is the sleep cycle's job, not a lookup's.
# Set True to restore the legacy destructive-read behavior.
READ_PATH_PRUNING_ENABLED=False

# --- Emotional Seeding ---
# Initial multiplier for emotional memories (Intensity > 1.0)
EMOTIONAL_SEED_FACTOR=3.0

# --- Bayesian Memory (v6.1 Dual-Kernel) ---
# Collections that use the Bayesian Utility Kernel instead of Affective FSRS.
# Default: skill_memories,work_memories,directive_memories
BAYESIAN_COLLECTIONS=skill_memories,work_memories,directive_memories
# Rate of uncertainty (beta) accumulation per day. Higher = faster forgetting.
BAYESIAN_STABILITY_KAPPA=0.05
# Alpha increment per successful recall. Higher = faster learning.
BAYESIAN_REINFORCEMENT_GAIN=1.0

# --- Logging ---
LOG_LEVEL=INFO
# LOG_JSON=False  # Enable structured JSON logging for Datadog/Kibana

# --- Hive Mind (Milvus) ---
# [ARCH-01 WARNING: SOVEREIGNTY BOUNDARY] 
# Enabling Milvus crosses the Zero-Egress Boundary. 
# By setting this to True, you explicitly authorize Red Pill to transmit 
# anonymized engrams outside your local machine to the collective database.
MILVUS_ENABLED=False
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB=default
# MILVUS_NLIST=128  # Parameters for IVF_FLAT index tuning

# --- Neuro-Immune Sensitivity (Biological Dashboard) ---
# Threshold for a signal to be actively injected in the context prompt
SIGNAL_VISIBILITY_THRESHOLD=5.0
# Base intensity for Swarm notifications
SIGNAL_BASE_NOTIFICATION=5.0
# Base intensity for Hardware/CUDA pain alerts
SIGNAL_BASE_PAIN_CUDA=7.0
# Rate at which an untreated pain signal escalates intensity per background pulse
SIGNAL_PAIN_ESCALATION_RATE=0.5
# Hours without interaction before triggering an amnesia warning (Korsakoff alert)
SIGNAL_AMNESIA_HOURS=4
# Number of maximum healthy semantic vectors before triggering a migraine alert
SIGNAL_MIGRAINE_VECTORS=25000

# ==========================================
# (6) Pre-Heating Protocol
# ==========================================
PRE_HEATING_ENABLED=True
PRE_HEATING_INJECTION_MODE=contextual
PRE_HEATING_SCORING_STRATEGY=composite
PRE_HEATING_QUALITY_THRESHOLD=5.0
PRE_HEATING_MAX_FRAGMENTS=3
PRE_HEATING_MAX_CHARS_PER_FRAGMENT=200
PRE_HEATING_LOOKBACK_HOURS=48
PRE_HEATING_HOT_COLORS=purple,blue,red
# Max tracked workspaces to show in PROJECT_STATUS (opt-in via track: true in workspaces.yaml)
PRE_HEATING_MAX_TRACKED_PROJECTS=3

# --- Operator Profile Update Interval ---
# Hours between automatic operator_profile.md updates (default: 24)
# The update runs during the sleep ritual if this many hours have passed.
OPERATOR_PROFILE_UPDATE_INTERVAL_HOURS=24
