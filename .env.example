# Red Pill Protocol Configuration (v6.1.0a3)
# Copy this file to .env and adjust as needed.

# --- Qdrant Settings ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_SCHEME=https
# [NEW v4.0.7] API Key for Qdrant (Optional but recommended for shared environments)
# QDRANT_API_KEY=your-secret-api-key

# ==========================================
# (5) MCP Configurations
# ==========================================
# Determines the noise filter for the interceptor (Low=0.3, High=0.6)
SEMANTIC_INTENT_THRESHOLD=Low
# Enables or disables the global MCP Interceptor RP tool (Defaults to False for privacy/security)
INTERCEPTOR_ENABLED=False

# --- Model Configuration ---
# FastEmbed model to use. changing this REQUIRES re-seeding!
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# [NEW v4.0.7] Vector dimensions. Must match the model.
VECTOR_SIZE=384

# --- B760-Adaptive Logic ---
# Decay Strategy: 'linear' (default) or 'exponential'
DECAY_STRATEGY=linear
# How much reinforcement score to subtract per erosion cycle
EROSION_RATE=0.05
# Score increment per search hit
REINFORCEMENT_INCREMENT=0.1
# How much score propagates to associated engrams (0.5 = 50% of increment)
PROPAGATION_FACTOR=0.5
# Score at which an engram becomes permanently immune to erosion
IMMUNITY_THRESHOLD=10.0
# [NEW v4.1.0] Custom triggers to automatically activate Deep Recall (comma-separated).
# Note: 'despierta' and 'wake up' are immune symbiosis triggers and are always added implicitly.
DEEP_RECALL_TRIGGERS="don't you remember,¿no te acuerdas?,deep recall,try hard!"

# --- Metabolism & Absence Guard ---
# If the bunker has been idle for more than this many seconds, a TTL refresh
# is triggered before erosion to prevent mass-deletion after long absences.
# Default: 7 days (604800)
ABSENCE_THRESHOLD=604800
# Comma-separated collections for automatic metabolism (erosion/refresh)
METABOLISM_AUTO_COLLECTIONS=work_memories,social_memories,story_memories
METABOLISM_ENABLED=True

# --- Emotional Seeding ---
# Initial multiplier for emotional memories (Intensity > 1.0)
EMOTIONAL_SEED_FACTOR=3.0

# --- Bayesian Memory (v6.1 Dual-Kernel) ---
# Collections that use the Bayesian Utility Kernel instead of Affective FSRS.
# Default: skill_memories,work_memories,directive_memories
BAYESIAN_COLLECTIONS=skill_memories,work_memories,directive_memories
# Rate of uncertainty (beta) accumulation per day. Higher = faster forgetting.
BAYESIAN_STABILITY_KAPPA=0.05
# Alpha increment per successful recall. Higher = faster learning.
BAYESIAN_REINFORCEMENT_GAIN=1.0

# --- Logging ---
LOG_LEVEL=INFO
# LOG_JSON=False  # Enable structured JSON logging for Datadog/Kibana

# --- Hive Mind (Milvus) ---
# [ARCH-01 WARNING: SOVEREIGNTY BOUNDARY] 
# Enabling Milvus crosses the Zero-Egress Boundary. 
# By setting this to True, you explicitly authorize Red Pill to transmit 
# anonymized engrams outside your local machine to the collective database.
MILVUS_ENABLED=False
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB=default
# MILVUS_NLIST=128  # Parameters for IVF_FLAT index tuning
