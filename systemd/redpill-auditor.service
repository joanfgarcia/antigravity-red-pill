[Unit]
Description=Red Pill Sentinel Auditor (Infrastructure Vitality Monitor)
After=network.target

[Service]
# Plantilla: %h = HOME del usuario; ajusta la ruta si el repo no vive en ~/Documents/IA/sharing.
Type=oneshot
WorkingDirectory=%h/Documents/IA/sharing
ExecStart=%h/Documents/IA/sharing/.venv/bin/python %h/Documents/IA/sharing/scripts/auditor_run.py
Environment=PYTHONPATH=%h/Documents/IA/sharing/src
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
