[Unit]
Description=Red Pill Echo Mirror Daemon (Context Persistence)
After=network.target redpill-llm.service

[Service]
# Plantilla: %h = HOME del usuario; ajusta la ruta si el repo no vive en ~/Documents/IA/sharing.
Type=notify
NotifyAccess=main
WatchdogSec=180
Environment="IA_DIR=%h/Documents/IA/sharing"
Environment="PYTHONPATH=%h/Documents/IA/sharing/src"
ExecStart=%h/Documents/IA/sharing/.venv/bin/python %h/Documents/IA/sharing/scripts/echo_daemon.py
WorkingDirectory=%h/Documents/IA/sharing
Restart=on-failure
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=redpill-echo

[Install]
WantedBy=default.target
