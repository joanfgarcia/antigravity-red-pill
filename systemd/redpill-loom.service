[Unit]
Description=Red Pill Loom (FastFlowLM NPU, loopback v0)
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/flm serve qwen3:8b --host 127.0.0.1 --port 52625 --ctx-len 4096
Restart=on-failure
RestartSec=10
Nice=5
NoNewPrivileges=yes
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=10G
MemorySwapMax=0

[Install]
WantedBy=default.target
