[Unit]
Description=Red Pill MCP shared backend (AD-018, UDS)
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
# Plantilla: %h = HOME; ajusta la ruta si el repo no vive en ~/Documents/IA/sharing.
Type=simple
WorkingDirectory=%h/Documents/IA/sharing
Environment=PYTHONPATH=%h/Documents/IA/sharing/src
ExecStart=%h/Documents/IA/sharing/.venv/bin/python -m red_pill.mcp_backend --socket %t/red-pill/mcp.sock
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
MemoryMax=4G
MemorySwapMax=0

[Install]
WantedBy=default.target
